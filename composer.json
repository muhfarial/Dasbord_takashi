{
    "name": "takashi/dasbord-takashi",
    "type": "project",
    "description": "Takashi Fried Chicken - QSR Real-Time Inventory & Supply Chain Cockpit (Laravel + React + MySQL)",
    "keywords": ["laravel", "react", "mysql", "inventory", "fefo", "qsr"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
